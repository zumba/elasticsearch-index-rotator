{
    "name": "zumba/elasticsearch-index-rotate",
    "description": "Safely rotate indexes with no downtime to end users.",
    "keywords": ["elasticsearch"],
    "authors": [
        {
            "name": "Chris Saylor",
            "email": "cjsaylor@gmail.com"
        }
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url":  "https://github.com/zumba/elasticsearch-php.git"
        },
        {
            "type": "vcs",
            "url":  "https://github.com/zumba/ringphp.git"
        }
    ],
    "require": {
        "php": "^8.0",
        "elasticsearch/elasticsearch": "dev-support-php8",
        "psr/log": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Zumba\\ElasticsearchRotator\\": "src/"
        }
    },
    "suggest": {
        "monolog/monolog": "Allows more advanced logging of the application flow"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "zumba/elasticsearchunit": "^1.3"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
